{
  "name": "liveog-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm --filter @liveog/basic dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "render": "pnpm --filter @liveog/cli start render",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "dev:web": "pnpm --filter @liveog/web dev",
    "build:web": "pnpm --filter @liveog/web build",
    "dev:github-stats": "pnpm --filter @liveog/github-stats dev",
    "dev:social-preview": "pnpm --filter @liveog/social-preview dev"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@liveog/cli": "workspace:^",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
