{
  "name": "@liveog/cli",
  "version": "0.2.0",
  "description": "Command line renderer for LiveOG animated Open Graph cards",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Julezbeyer/liveog.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Julezbeyer/liveog#readme",
  "bugs": "https://github.com/Julezbeyer/liveog/issues",
  "keywords": [
    "open-graph",
    "og-image",
    "cli",
    "playwright",
    "ffmpeg"
  ],
  "type": "module",
  "bin": {
    "liveog": "./dist/index.js"
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/config.ts --format esm --dts --clean",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@liveog/renderer": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  }
}
