{
  "name": "@liveog/react",
  "version": "0.1.0",
  "description": "React components for authoring animated LiveOG Open Graph cards",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Julezbeyer/liveog.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Julezbeyer/liveog#readme",
  "bugs": "https://github.com/Julezbeyer/liveog/issues",
  "keywords": [
    "open-graph",
    "og-image",
    "react",
    "animation",
    "social-cards"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": "./src/index.tsx",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --clean --external react"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@liveog/core": "workspace:*"
  }
}
